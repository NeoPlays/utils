{
  "title": "Lido Consolidations",
  "uid": "lido-consolidations",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Overall Progress",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75,
        "minVizHeight": 75,
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "eth_consolidation_progress_ratio",
          "legendFormat": "Progress"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Source Status Summary",
      "gridPos": { "x": 5, "y": 0, "w": 7, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "eth_consolidation_sources_total",
          "legendFormat": "Total"
        },
        {
          "expr": "eth_consolidation_sources_withdrawn",
          "legendFormat": "Fully Withdrawn"
        },
        {
          "expr": "eth_consolidation_sources_exited",
          "legendFormat": "Exited (pending sweep)"
        },
        {
          "expr": "eth_consolidation_sources_total - eth_consolidation_sources_withdrawn - eth_consolidation_sources_exited",
          "legendFormat": "Remaining Active"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Target Validator Balances",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "eth_consolidation_target_balance_eth",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Consolidation Progress Over Time",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "targets": [
        {
          "expr": "eth_consolidation_progress_ratio",
          "legendFormat": "Progress"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Target Fill Ratios (vs 2048 ETH max)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "minVizWidth": 10,
        "minVizHeight": 10,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "eth_consolidation_target_fill_ratio",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Source Validator Status Breakdown",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum by (status) (eth_consolidation_source_count)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Target Key Balances",
      "gridPos": { "x": 0, "y": 26, "w": 11, "h": 12 },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Value" }]
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "target" },
            "properties": [{ "id": "custom.width", "value": 820 }]
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": { "names": ["target", "Value"] }
          }
        }
      ],
      "targets": [
        {
          "expr": "eth_consolidation_target_balance_eth",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Source Status per Target",
      "gridPos": { "x": 11, "y": 26, "w": 13, "h": 12 },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "target" }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "target" },
            "properties": [{ "id": "custom.width", "value": 400 }]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": { "names": ["target", "status", "Value"] }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [{ "displayName": "target", "desc": false }]
          }
        }
      ],
      "targets": [
        {
          "expr": "eth_consolidation_source_count",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    }
  ]
}
