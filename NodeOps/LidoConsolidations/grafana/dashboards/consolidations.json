{
  "title": "Lido Consolidations",
  "uid": "lido-consolidations",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Overall Progress",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75,
        "minVizHeight": 75,
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "eth_consolidation_progress_ratio",
          "legendFormat": "Progress"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sources Exited / Total",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "eth_consolidation_sources_exited",
          "legendFormat": "Exited"
        },
        {
          "expr": "eth_consolidation_sources_total",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Target Validator Balances",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "eth_consolidation_target_balance_gwei / 1e9",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Target Key Balances",
      "gridPos": { "x": 0, "y": 18, "w": 11, "h": 12 },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Value" }]
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "target" },
            "properties": [{ "id": "custom.width" }]
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": { "names": ["target", "Value"] }
          }
        }
      ],
      "targets": [
        {
          "expr": "eth_consolidation_target_balance_gwei",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Source Validator Status Breakdown",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum by (status) (eth_consolidation_source_count)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
